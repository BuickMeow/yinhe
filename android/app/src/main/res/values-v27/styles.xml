<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 27+：挖孔/刘海设备窗口避开 cutout 区域（系统自动加黑边，
         与 FLM/Cubasis 等专业音频 app 一致）。API 26 无挖孔概念，无需处理。
         注意：edge-to-edge（setDecorFitsSystemWindows(false)）下此模式
         仍生效——窗口不绘制到挖孔区，避免内容被摄像头遮挡。 -->
    <style name="Theme.Yinhe" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">never</item>
    </style>
</resources>
